{
  "name": "Comptoir API request limit",
  "description": "Limit requests to server endpoints per IP before they reach Vercel Functions.",
  "active": true,
  "conditionGroup": [{ "conditions": [{ "type": "path", "op": "pre", "value": "/api/" }] }],
  "action": {
    "mitigate": {
      "action": "rate_limit",
      "rateLimit": { "algo": "fixed_window", "window": 60, "limit": 30, "keys": ["ip"], "action": "rate_limit" }
    }
  }
}
